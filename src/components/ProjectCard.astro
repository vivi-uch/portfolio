---
import { statusLabel, type Project } from "../data/site";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const status = statusLabel[project.status];

// Only shipped work gets the accent treatment; anything unfinished stays
// visually quieter so it never reads as a finished claim.
const isShipped = project.status === "shipped";
---

<article
  data-reveal
  class="group relative flex flex-col rounded-lg border border-[var(--color-line)] bg-[var(--color-surface)] p-6 transition-colors duration-200 hover:border-[var(--color-line-strong)] md:p-7"
>
  <div class="flex items-center justify-between gap-4">
    <p
      class="font-mono text-[0.6875rem] uppercase tracking-[0.16em] text-[var(--color-ink-subtle)]"
    >
      {project.year}
    </p>
    <span
      class:list={[
        "inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 font-mono text-[0.6875rem] uppercase tracking-wider",
        isShipped
          ? "border-[var(--color-accent)]/30 bg-[var(--color-accent-soft)] text-[var(--color-accent)]"
          : "border-[var(--color-line)] text-[var(--color-ink-subtle)]",
      ]}
    >
      <span
        class:list={[
          "size-1.5 rounded-full",
          isShipped ? "bg-[var(--color-accent)]" : "bg-[var(--color-ink-subtle)]",
        ]}
        aria-hidden="true"></span>
      {status}
    </span>
  </div>

  <h3 class="mt-6 text-xl font-semibold tracking-tight text-[var(--color-ink)]">
    <!-- The whole card is clickable via this stretched link. -->
    <a
      href={`/work/${project.slug}`}
      class="after:absolute after:inset-0 focus-visible:outline-offset-4"
    >
      {project.name}
    </a>
  </h3>

  <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-muted)]">
    {project.tagline}
  </p>

  <ul class="mt-6 flex flex-wrap gap-1.5">
    {
      project.stack.slice(0, 4).map((item) => (
        <li class="rounded border border-[var(--color-line)] px-2 py-1 font-mono text-[0.6875rem] text-[var(--color-ink-subtle)]">
          {item}
        </li>
      ))
    }
    {
      project.stack.length > 4 && (
        <li class="rounded border border-[var(--color-line)] px-2 py-1 font-mono text-[0.6875rem] text-[var(--color-ink-subtle)]">
          +{project.stack.length - 4}
        </li>
      )
    }
  </ul>

  <p
    class="mt-7 flex items-center gap-1.5 pt-1 text-sm font-medium text-[var(--color-ink-muted)] transition-colors duration-150 group-hover:text-[var(--color-accent)]"
    aria-hidden="true"
  >
    Read case study
    <svg
      width="14"
      height="14"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M2 8h11M9 4l4 4-4 4"></path>
    </svg>
  </p>
</article>