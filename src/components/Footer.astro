---
import { CONTACT, SITE } from "../data/site";

const year = new Date().getFullYear();
---
<footer
  id="contact"
  class="scroll-mt-24 border-t border-[var(--color-line)] bg-[var(--color-surface)]"
>
  <div class="container-page py-20 md:py-28">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr]">
      <div data-reveal>
        <p
          class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--color-ink-subtle)]"
        >
          Contact
        </p>
        <h2
          class="mt-5 max-w-[22ch] text-3xl font-semibold leading-tight tracking-tight text-balance md:text-4xl"
        >
          Open to frontend roles and contract work.
        </h2>
        <p class="mt-5 max-w-[52ch] leading-relaxed text-[var(--color-ink-muted)]">
          If you're building something that needs a careful interface — or you
          want to talk about any of the work above — email is the fastest way to
          reach me.
        </p>

        <a
          href={`mailto:${CONTACT.email}`}
          class="mt-8 inline-flex items-center gap-2.5 rounded-full bg-[var(--color-accent)] px-6 py-3.5 text-sm font-semibold text-[#04140d] transition-colors duration-150 hover:bg-[#0ea472]"
        >
          {CONTACT.email}
          <svg
            width="14"
            height="14"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M2 8h11M9 4l4 4-4 4"></path>
          </svg>
        </a>
      </div>

      <div class="md:pt-1" data-reveal>
        <p
          class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--color-ink-subtle)]"
        >
          Elsewhere
        </p>
        <ul class="mt-5 divide-y divide-[var(--color-line)] border-y border-[var(--color-line)]">
          <li>
            <a
              href={CONTACT.github}
              rel="me noopener"
              class="flex items-center justify-between gap-4 py-4 text-sm text-[var(--color-ink-muted)] transition-colors duration-150 hover:text-[var(--color-accent)]"
            >
              <span>GitHub</span>
              <span aria-hidden="true" class="font-mono text-[var(--color-ink-subtle)]"
                >↗</span
              >
            </a>
          </li>
          <li>
            <a
              href={CONTACT.linkedin}
              rel="me noopener"
              class="flex items-center justify-between gap-4 py-4 text-sm text-[var(--color-ink-muted)] transition-colors duration-150 hover:text-[var(--color-accent)]"
            >
              <span>LinkedIn</span>
              <span aria-hidden="true" class="font-mono text-[var(--color-ink-subtle)]"
                >↗</span
              >
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-16 flex flex-col gap-3 border-t border-[var(--color-line)] pt-8 font-mono text-xs text-[var(--color-ink-subtle)] sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {SITE.name}</p>
      <p>Built with Astro, Tailwind CSS.</p>
    </div>
  </div>
</footer>