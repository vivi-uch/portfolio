---
/**
 * Fixed top navigation.
 *
 * Desktop shows section anchors; mobile collapses to a toggle. The active
 * section is highlighted by a small IntersectionObserver script in the
 * layout, which sets aria-current on the matching link.
 */
import { CONTACT, NAV_ITEMS, SITE } from "../data/site";

// Links back to the home page with a section anchor when we're on a
// case-study page, and a bare anchor when we're already home.
const { pathname } = Astro.url;
const isHome = pathname === "/" || pathname === "";
const sectionHref = (id: string) => (isHome ? `#${id}` : `/#${id}`);

const initials = SITE.name
  .split(" ")
  .map((part) => part[0])
  .join("");
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-[var(--color-line)] bg-[var(--color-canvas)]/85 backdrop-blur-md"
>
  <nav
    aria-label="Primary"
    class="container-page flex h-16 items-center justify-between gap-6"
  >
    <a
      href={isHome ? "#top" : "/"}
      class="group flex items-center gap-2.5 rounded-sm"
    >
      <span
        class="grid size-7 place-items-center rounded-md border border-[var(--color-line-strong)] font-mono text-[0.6875rem] font-medium text-[var(--color-accent)]"
        aria-hidden="true">{initials}</span
      >
      <span class="text-sm font-medium tracking-tight text-[var(--color-ink)]"
        >{SITE.name}</span
      >
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        NAV_ITEMS.map((item) => (
          <li>
            <a
              href={sectionHref(item.id)}
              data-nav-link={item.id}
              class="rounded-md px-3 py-2 text-sm text-[var(--color-ink-muted)] transition-colors duration-150 hover:text-[var(--color-ink)] aria-[current=true]:text-[var(--color-ink)]"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hidden items-center gap-2 md:flex">
      <a
        href={CONTACT.github}
        rel="me noopener"
        class="rounded-md px-3 py-2 text-sm text-[var(--color-ink-muted)] transition-colors duration-150 hover:text-[var(--color-ink)]"
        >GitHub</a
      >
      <a
        href={`mailto:${CONTACT.email}`}
        class="rounded-md border border-[var(--color-line-strong)] px-3.5 py-2 text-sm font-medium text-[var(--color-ink)] transition-colors duration-150 hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
        >Email</a
      >
    </div>

    <button
      type="button"
      id="nav-toggle"
      class="grid size-9 place-items-center rounded-md border border-[var(--color-line-strong)] text-[var(--color-ink-muted)] transition-colors duration-150 hover:text-[var(--color-ink)] md:hidden"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Open navigation menu"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M2 4.5h12M2 8h12M2 11.5h12"></path>
      </svg>
    </button>
  </nav>

  <!-- Mobile menu: hidden until the toggle script expands it. -->
  <div
    id="nav-menu"
    hidden
    class="border-t border-[var(--color-line)] bg-[var(--color-canvas)] md:hidden"
  >
    <ul class="container-page flex flex-col gap-1 py-4">
      {
        NAV_ITEMS.map((item) => (
          <li>
            <a
              href={sectionHref(item.id)}
              data-nav-mobile-link
              class="block rounded-md px-2 py-3 text-sm text-[var(--color-ink-muted)] transition-colors duration-150 hover:text-[var(--color-ink)]"
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="mt-2 flex gap-2 border-t border-[var(--color-line)] pt-4">
        <a
          href={CONTACT.github}
          rel="me noopener"
          class="flex-1 rounded-md border border-[var(--color-line-strong)] px-3 py-2.5 text-center text-sm text-[var(--color-ink)]"
          >GitHub</a
        >
        <a
          href={`mailto:${CONTACT.email}`}
          class="flex-1 rounded-md border border-[var(--color-line-strong)] px-3 py-2.5 text-center text-sm font-medium text-[var(--color-ink)]"
          >Email</a
        >
      </li>
    </ul>
  </div>
</header>